# Arena Factory Hoolulu — optional. The factory runs fully offline without these.

# Optional LLM (OpenAI-compatible). Leave blank to use the local generator.
FACTORY_LLM_API_KEY=
FACTORY_LLM_BASE_URL=https://api.openai.com/v1
FACTORY_LLM_MODEL=gpt-4o-mini

# Operator ping channel (dashboard always; telegram is optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bind
HOST=0.0.0.0
PORT=8080
